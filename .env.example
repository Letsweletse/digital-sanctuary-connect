# Public site address (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://gategaborone.co.bw

# Supabase (sermon records). Project Settings > API

# Cloudflare R2 (sermon audio). R2 > Manage API tokens (Object Read & Write on the bucket)
# Public address of the bucket, e.g. https://media.gategaborone.co.bw

# Admin upload page password (long and random)
ADMIN_KEY=

# Resend (contact form)
RESEND_API_KEY=
CONTACT_FROM=Gate Gaborone Website <website@gategaborone.co.bw>
CONTACT_TO=info@gategaborone.co.bw
BLOB_READ_WRITE_TOKEN= # added automatically by Vercel when the Blob store is connected
